# Heroku, avec le buildpack emk/rust : il installe Rust, puis heroku-build.sh construit
# le serveur (le buildpack publié ignore RUST_CARGO_BUILD_FLAGS, d'où ce détour).
VERSION=stable
RUST_SKIP_BUILD=1
trap 'status=$?; if [ "$status" -eq 0 ]; then ENV_DIR="$ENV_DIR" bash "$BUILD_DIR/heroku-build.sh" || exit 1; fi' EXIT
